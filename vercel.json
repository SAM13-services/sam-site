{
  "trailingSlash": false,
  "redirects": [
    { "source": "/200", "destination": "/", "permanent": true },
    { "source": "/404", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|sitemap\\.xml|robots\\.txt|images|animations).*)",
      "destination": "/index.html"
    }
  ]
}
