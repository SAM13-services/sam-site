{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sam-contact.fr" }],
      "destination": "https://sam-contact.fr/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|sitemap\\.xml|robots\\.txt|images|animations).*)",
      "destination": "/index.html"
    }
  ]
}
